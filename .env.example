# SmartTrim 360 — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Application ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — no setup required):
DATABASE_URL=sqlite:///./smarttrim.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/smarttrim360

# Enable SQLAlchemy query logging (dev only):
DB_ECHO=false

# ── Redis (async job queue) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Models ─────────────────────────────────────────────────────────────────
# HuggingFace cache directory (optional — defaults to ~/.cache/huggingface)
# HF_HOME=/path/to/large/disk/.cache/huggingface

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins:
# CORS_ORIGINS=https://your-app.vercel.app,https://smarttrim360.com
